---
import { Image, getImage } from 'astro:assets';
import type { Work } from '../lib/works';
import { withBase } from '../lib/works';

interface Props {
  work: Work;
  sizes: string;
  class?: string;
  eager?: boolean;
  /** Ambient: läuft dauerhaft (z. B. im Hero), ignoriert Hover */
  ambient?: boolean;
}
const { work, sizes, class: cls = '', eager = false, ambient = false } = Astro.props;
const d = work.data;
const alt = `${d.kind}: ${d.title} – ${d.client}`;
const poster = d.medium === 'video' ? await getImage({ src: d.image, width: 960, format: 'webp' }) : null;
---

{d.medium === 'video' && d.video ? (
  <video
    class={cls}
    muted
    loop
    playsinline
    preload="none"
    poster={poster?.src}
    width={d.image.width}
    height={d.image.height}
    aria-label={alt}
    data-work-video={!ambient ? '' : undefined}
    data-ambient={ambient ? '' : undefined}
  >
    <source src={withBase(d.video)} type="video/mp4" />
  </video>
) : (
  <Image
    src={d.image}
    alt={alt}
    widths={[480, 800, 1200, 1600].filter((w) => w <= d.image.width)}
    sizes={sizes}
    class={cls}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
)}
