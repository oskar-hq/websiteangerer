---
/**
 * V2 „Nacht“ – sehr dunkles Blau, die Arbeiten leuchten wie auf einer Bühne.
 */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import WorkMedia from '../components/WorkMedia.astro';
import StickyCall from '../components/StickyCall.astro';
import LogoMark from '../components/LogoMark.astro';
import Icon from '../components/Icon.astro';
import { site, tel, wa, disciplines } from '../site.config';
import { getWorks, disciplineLabel, countBy } from '../lib/works';

const works = await getWorks();
const counts = countBy(works);
const pad = (n: number) => String(n).padStart(2, '0');

// Hero-Laufband: Auswahl aus der Wand
const pick = works.filter((_, i) => i % 2 === 0);
const colA = pick.filter((_, i) => i % 2 === 0);
const colB = pick.filter((_, i) => i % 2 === 1);
const strip = works.filter((w) => w.data.image.width >= w.data.image.height).slice(0, 10);
const byDisc = (id: string) => works.filter((w) => w.data.discipline === id).slice(0, 3);
---

<Base theme="v2" current="v2" title={`${site.name} – V2 Nacht`}>
  <header class="v2-head absolute inset-x-0 top-0 z-40 md:fixed">
    <div class="mx-auto flex h-16 max-w-[1440px] items-center justify-between px-4 md:h-20 md:px-10">
      <a href="#top" class="font-display text-[19px] font-bold tracking-[-0.045em]">{site.name}</a>
      <nav class="hidden items-center gap-8 text-[14px] text-muted md:flex">
        <a href="#wand" class="transition-colors hover:text-fg">Arbeiten</a>
        <a href="#disziplinen" class="transition-colors hover:text-fg">Disziplinen</a>
        <a href={tel} class="inline-flex h-10 items-center gap-2 rounded-full bg-accent px-5 font-semibold text-on-accent transition-transform hover:-translate-y-px">
          <Icon name="phone" size={15} /> Anrufen
        </a>
      </nav>
    </div>
  </header>

  <main id="top" class="pb-24 md:pb-0">
    <!-- 1 · HERO -->
    <section data-hero class="relative flex min-h-svh flex-col overflow-hidden pb-[84px] md:pb-0">
      <!-- Mobile: Laufband der Arbeiten oben -->
      <div class="relative mt-16 h-[34svh] overflow-hidden md:hidden" aria-hidden="true">
        <div class="marquee h-full gap-2 [--marquee-dur:46s]">
          {[0, 1].map(() => strip.map((w) => (
            <Image src={w.data.image} alt="" widths={[480]} sizes="60vw" class="h-full w-auto rounded-xl object-cover" loading="eager" />
          )))}
        </div>
        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-bg to-transparent"></div>
      </div>

      <div class="mx-auto grid w-full max-w-[1440px] flex-1 px-4 md:grid-cols-12 md:gap-10 md:px-10">
        <div class="flex flex-col justify-end pb-6 pt-4 md:col-span-7 md:pb-10 md:pt-28">
          <p class="mb-5 flex items-center gap-2 text-[13px] text-muted md:mb-8" data-reveal>
            <span class="inline-block size-1.5 rounded-full bg-accent shadow-[0_0_12px_var(--accent)]"></span>
            Ein Netzwerk der besten Profis Deutschlands
          </p>
          <h1 class="display font-bold text-[clamp(3.4rem,17vw,5rem)] tracking-[-0.06em] md:text-[min(8.6vw,15.5svh)]">
            <span class="block" data-reveal style="--d:60ms">Marvin</span>
            <span class="block" data-reveal style="--d:140ms">Angerer<span class="text-accent">.</span></span>
          </h1>
          <div class="mt-6 max-w-[34rem] md:mt-10" data-reveal style="--d:260ms">
            <p class="font-display text-[clamp(1.45rem,6.4vw,1.75rem)] font-semibold leading-[1.08] tracking-[-0.035em] md:text-[2.25rem]">
              Ein Name. Ein Anruf.<br /><span class="text-muted">Das Beste, was Deutschland zu bieten hat.</span>
            </p>
          </div>
          <div class="mt-10 hidden gap-3 md:flex" data-reveal style="--d:360ms">
            <a href={tel} class="v2-cta inline-flex h-14 items-center gap-3 rounded-full bg-accent pl-6 pr-7 text-[16px] font-semibold text-on-accent">
              <Icon name="phone" size={18} /> {site.phoneDisplay}
            </a>
            <a href={wa} target="_blank" rel="noopener" class="inline-flex h-14 items-center gap-3 rounded-full bg-surface px-6 text-[16px] font-medium shadow-[inset_0_0_0_1px_var(--line)] transition-colors hover:shadow-[inset_0_0_0_1px_#3a4a6e]">
              <Icon name="whatsapp" size={19} /> WhatsApp
            </a>
          </div>
        </div>

        <!-- Desktop: zwei vertikale Laufbänder -->
        <div class="relative mb-6 mt-24 hidden md:col-span-5 md:block" aria-hidden="true">
          <div class="absolute inset-0 grid grid-cols-2 gap-3 [mask-image:linear-gradient(transparent,#000_18%,#000_82%,transparent)]">
            {[colA, colB].map((col, ci) => (
              <div class="overflow-hidden">
                <div class:list={['marquee-y flex flex-col gap-3', ci === 1 && '[animation-direction:reverse]']} style={`--marquee-dur:${ci ? 70 : 58}s`}>
                  {[0, 1].map(() => col.map((w) => (
                    <Image src={w.data.image} alt="" widths={[480, 800]} sizes="20vw" class="w-full rounded-[14px] opacity-90" loading="eager" />
                  )))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="border-t border-line" data-reveal style="--d:460ms">
        <div class="mx-auto flex max-w-[1440px] items-center gap-8 py-5 md:px-10 md:py-6">
          <span class="hidden shrink-0 text-[12px] leading-tight text-muted md:block">Vertrauen von<br /><span class="opacity-60">Platzhalter-Logos</span></span>
          <div class="relative flex-1 overflow-hidden [mask-image:linear-gradient(90deg,transparent,#000_8%,#000_92%,transparent)]">
            <div class="marquee [--marquee-dur:44s]">
              {[0, 1].map((dup) => (
                <ul class="flex shrink-0 items-center gap-12 pr-12 text-[18px] text-fg/50 md:gap-16 md:pr-16 md:text-[20px]" aria-hidden={dup === 1 ? 'true' : undefined}>
                  {site.logos.map((l, i) => <li><LogoMark name={l} i={i} /></li>)}
                </ul>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2 · DIE WAND -->
    <section id="wand" data-wall data-active="all" class="md:scroll-mt-20">
      <div class="mx-auto max-w-[1440px] px-4 pt-20 md:px-10 md:pt-36">
        <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
          <h2 class="display font-bold text-[clamp(2.5rem,12vw,3.25rem)] tracking-[-0.055em] md:text-[clamp(3.5rem,6vw,6rem)]" data-reveal>
            Die Wand<span class="text-accent">.</span>
          </h2>
          <p class="max-w-sm text-[15px] text-muted md:pb-3 md:text-right" data-reveal style="--d:80ms">
            <span data-count class="text-fg">{pad(works.length)}</span> Arbeiten aus dem Netzwerk – Plakate, Thumbnails, Reels, Kampagnen und Software.
          </p>
        </div>
      </div>

      <div class="sticky top-0 z-30 mt-8 bg-bg/85 backdrop-blur-md md:static md:mt-12 md:bg-transparent md:backdrop-blur-none">
        <div class="mx-auto max-w-[1440px] md:px-10">
          <div class="v2-filter flex gap-1.5 overflow-x-auto px-4 py-3 [scrollbar-width:none] md:inline-flex md:rounded-full md:bg-surface md:p-1.5 md:shadow-[inset_0_0_0_1px_var(--line)]" role="toolbar" aria-label="Nach Disziplin filtern">
            <button type="button" data-filter="all" aria-pressed="true">Alle</button>
            {disciplines.map((d) => <button type="button" data-filter={d.id} aria-pressed="false">{d.label}</button>)}
          </div>
        </div>
      </div>

      <div class="mx-auto max-w-[1600px] md:px-6 md:pt-10 lg:px-10">
        <div class="md:columns-2 md:gap-3 lg:columns-3 xl:columns-4">
          {works.map((w, i) => (
            <figure data-tile data-discipline={w.data.discipline} class="v2-tile group relative mb-1 snap-start scroll-mt-16 break-inside-avoid overflow-hidden md:mb-3 md:scroll-mt-0 md:rounded-[14px]" style={`view-transition-name: w${i}`}>
              <WorkMedia work={w} sizes="(min-width: 1280px) 23vw, (min-width: 1024px) 31vw, (min-width: 768px) 48vw, 100vw" class="h-auto max-h-[82svh] w-full object-cover transition-[transform,filter] duration-[1.1s] ease-[var(--ease-out)] md:max-h-none md:group-hover:scale-[1.035]" />
              <div class="pointer-events-none absolute left-3 top-3 flex gap-1.5">
                {w.data.placeholder && <span class="ph-badge">Platzhalter</span>}
                {w.data.medium === 'video' && <span class="ph-badge">▶</span>}
              </div>
              <figcaption class="v2-cap pointer-events-none absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 px-4 pb-4 pt-16">
                <span class="min-w-0">
                  <span class="block truncate text-[15px] font-semibold tracking-[-0.01em] text-white">{w.data.title}</span>
                  <span class="block truncate text-[13px] text-white/65">{w.data.client}</span>
                </span>
                <span class="shrink-0 rounded-full bg-white/10 px-2.5 py-1 text-[11px] font-medium text-white/85 backdrop-blur-md">{disciplineLabel(w.data.discipline)}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- 3 · DISZIPLINEN -->
    <section id="disziplinen" class="mx-auto max-w-[1440px] px-4 pt-24 md:px-10 md:pt-44">
      <h2 class="mb-8 text-[13px] text-muted md:mb-12" data-reveal>Disziplinen</h2>
      <ul>
        {disciplines.map((d, i) => (
          <li class="border-t border-line last:border-b" data-reveal style={`--d:${i * 70}ms`}>
            <a href="#wand" data-filter={d.id} class="v2-disc group relative flex flex-col gap-4 py-6 md:flex-row md:items-center md:gap-10 md:py-8">
              <span class="flex items-baseline gap-4 md:w-[44%]">
                <span class="w-7 text-[13px] tabular-nums text-muted">{pad(i + 1)}</span>
                <span class="display font-bold text-[2.4rem] tracking-[-0.055em] transition-colors duration-300 group-hover:text-accent md:text-[clamp(3rem,5.2vw,5rem)]">{d.label}</span>
              </span>
              <span class="pl-11 text-[15px] text-muted md:flex-1 md:pl-0">{d.line}</span>
              <span class="v2-peek flex gap-2 pl-11 md:w-[300px] md:justify-end md:pl-0" aria-hidden="true">
                {byDisc(d.id).map((w, k) => (
                  <Image src={w.data.image} alt="" widths={[240]} sizes="96px" class="h-16 w-24 rounded-lg object-cover md:h-20 md:w-[92px]" style={`--k:${k}`} />
                ))}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- 4 · ABSCHLUSS -->
    <section class="mx-auto max-w-[1440px] px-4 pb-10 pt-28 text-center md:px-10 md:pb-12 md:pt-56">
      <p class="mb-6 text-[13px] text-muted" data-reveal>Kein Formular. Keine Agentur-Schleifen.</p>
      <h2 class="display font-bold text-[clamp(3.4rem,17vw,5rem)] tracking-[-0.06em] md:text-[clamp(5rem,11vw,11rem)]" data-reveal style="--d:80ms">
        Ein Anruf<span class="text-accent">.</span>
      </h2>
      <div class="mt-10 flex flex-col items-stretch justify-center gap-3 md:mt-14 md:flex-row md:items-center" data-reveal style="--d:180ms">
        <a href={tel} class="v2-cta inline-flex h-16 items-center justify-center gap-3 rounded-full bg-accent px-9 text-[18px] font-semibold text-on-accent">
          <Icon name="phone" size={20} /> {site.phoneDisplay}
        </a>
        <a href={wa} target="_blank" rel="noopener" class="inline-flex h-16 items-center justify-center gap-3 rounded-full bg-surface px-9 text-[18px] font-medium shadow-[inset_0_0_0_1px_var(--line)]">
          <Icon name="whatsapp" size={21} /> WhatsApp
        </a>
      </div>
      <footer class="mt-28 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6 text-[12px] text-muted md:mt-44">
        <span>© 2026 {site.name}</span>
        <span class="flex gap-6"><a href="#" class="hover:text-fg">Impressum</a><a href="#" class="hover:text-fg">Datenschutz</a></span>
      </footer>
    </section>
  </main>

  <StickyCall variant="dark" />
</Base>

<style>
  .v2-head { transition: background 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out); }
  :global(html[data-after-hero]) .v2-head {
    @media (min-width: 768px) {
      background: rgb(7 14 28 / 0.78);
      backdrop-filter: blur(14px);
      box-shadow: 0 1px 0 var(--line);
    }
  }
  .v2-cta { transition: transform 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out); }
  .v2-cta:hover { transform: translateY(-1px); box-shadow: 0 10px 40px -10px rgb(91 184 255 / 0.6); }

  .v2-filter button {
    flex-shrink: 0;
    height: 36px;
    padding: 0 16px;
    border-radius: 999px;
    font-size: 14px;
    color: var(--muted);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    transition: color 0.25s, background 0.25s;
  }
  .v2-filter button:hover { color: var(--fg); }
  .v2-filter button[aria-pressed='true'] { background: var(--accent); color: var(--on-accent); box-shadow: none; font-weight: 600; }
  @media (min-width: 768px) {
    .v2-filter button { background: transparent; box-shadow: none; }
  }

  .v2-tile { background: var(--surface); }
  .v2-cap { background: linear-gradient(to top, rgb(7 14 28 / 0.88), rgb(7 14 28 / 0)); }
  @media (hover: hover) and (pointer: fine) {
    .v2-tile { transition: box-shadow 0.5s var(--ease-out); }
    .v2-tile:hover { box-shadow: 0 0 0 1px rgb(91 184 255 / 0.55), 0 24px 70px -24px rgb(91 184 255 / 0.45); }
    .v2-cap { opacity: 0; transform: translateY(8px); transition: opacity 0.4s var(--ease-out), transform 0.4s var(--ease-out); }
    .v2-tile:hover .v2-cap { opacity: 1; transform: none; }
    .v2-tile :global(img), .v2-tile :global(video) { filter: saturate(0.9) brightness(0.92); }
    .v2-tile:hover :global(img), .v2-tile:hover :global(video) { filter: none; }

    .v2-peek :global(img) {
      opacity: 0;
      transform: translateX(14px) scale(0.96);
      transition: opacity 0.45s var(--ease-out), transform 0.45s var(--ease-out);
      transition-delay: calc(var(--k) * 60ms);
    }
    .v2-disc:hover .v2-peek :global(img) { opacity: 1; transform: none; }
  }
</style>
