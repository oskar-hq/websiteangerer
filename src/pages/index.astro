---
/**
 * Startseite – Museum-Prinzip: Die Seite ist nahezu farblos, die Marken sind die Bilder.
 * Hellblau ausschließlich für Anruf, WhatsApp und aktiven Filter.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import LogoTile from '../components/LogoTile.astro';
import Orbit from '../components/Orbit.astro';
import ClientDialog from '../components/ClientDialog.astro';
import WorkTile from '../components/WorkTile.astro';
import StickyCall from '../components/StickyCall.astro';
import Icon from '../components/Icon.astro';
import { site, tel, wa, disciplines } from '../site.config';
import { getWorks, countBy } from '../lib/works';

const works = await getWorks();
const counts = countBy(works);
const clients = (await getCollection('clients')).sort((a, b) => a.data.order - b.data.order);
const headliners = clients.filter((c) => c.data.tier === 1);
const lineup = clients.filter((c) => c.data.tier !== 1);
const pad = (n: number) => String(n).padStart(2, '0');
const featured = works.filter((w) => w.data.featured).slice(0, 6);
// Mobile-Feed: Lineup in Bildschirme zu je 4 Kacheln (2 × 2)
const chunks = Array.from({ length: Math.ceil(lineup.length / 4) }, (_, k) => lineup.slice(k * 4, k * 4 + 4));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Welche Profis stehen hinter welcher Disziplin (aus den Kundendaten abgeleitet)
const whoBy = (label: string) => [...new Set(clients.flatMap((c) => c.data.items.filter((i) => i.discipline === label).map((i) => i.who)))];
const whoExtra: Record<string, string[]> = { Software: ['Ylva Labs'] };
---

<Base htmlClass="feed">
  <header class="head fixed inset-x-0 top-0 z-30">
    <div class="mx-auto grid h-16 max-w-[1440px] grid-cols-2 items-center px-4 md:h-[84px] md:grid-cols-3 md:px-10">
      <a href="#top" class="text-[15px] font-medium tracking-[-0.02em]">{site.name}</a>
      <nav class="meta neu-sm hidden h-11 items-center justify-self-center rounded-full px-2 text-muted md:flex">
        <a href="#netzwerk" class="rounded-full px-4 py-2 transition-colors hover:text-fg">Netzwerk</a>
        <a href="#arbeiten" class="rounded-full px-4 py-2 transition-colors hover:text-fg">Arbeiten</a>
        <a href="#disziplinen" class="rounded-full px-4 py-2 transition-colors hover:text-fg">Disziplinen</a>
      </nav>
      <a href={tel} class="btn-call hidden h-11 items-center gap-2 justify-self-end rounded-full px-5 text-[13px] font-semibold md:inline-flex">
        <Icon name="phone" size={14} /> Anrufen
      </a>
    </div>
  </header>

  <main id="top">
    <!-- HERO: links Botschaft + Anruf, rechts Marvin mit dem Netzwerk im Orbit -->
    <section data-hero class="screen-hero relative mx-auto grid min-h-svh max-w-[1440px] snap-start snap-always grid-rows-[auto_1fr] px-4 pb-[100px] pt-16 md:grid-cols-12 md:grid-rows-1 md:items-center md:gap-6 md:px-10 md:pb-10 md:pt-[84px]">
      <div class="relative order-1 h-[46svh] min-h-[330px] md:order-2 md:col-span-7 md:h-[min(78svh,760px)]">
        <Orbit clients={clients} works={works} />
      </div>
      <div class="relative z-10 order-2 self-end md:order-1 md:col-span-5 md:self-center">
        <h1 class="display text-[clamp(2.9rem,14vw,3.75rem)] md:text-[min(6.6vw,7.25rem)]">
          <span class="block" data-reveal style="--d:120ms">Ein Name.</span>
          <span class="block text-muted" data-reveal style="--d:220ms">Ein Anruf.</span>
        </h1>
        <p class="mt-5 max-w-[26rem] text-[15px] leading-[1.55] text-muted md:mt-8 md:text-[16px]" data-reveal style="--d:320ms">
          Das Beste, was Deutschland zu bieten hat: Designer, Videoproduzenten, Social-Media-Teams, Manager und Software-Entwickler aus einem Netzwerk.
        </p>
        <div class="mt-9 hidden items-center gap-4 md:flex" data-reveal style="--d:420ms">
          <a href={tel} class="btn-call inline-flex h-14 items-center gap-2.5 rounded-full px-7 text-[15px] font-semibold">
            <Icon name="phone" size={17} /> Marvin anrufen
          </a>
          <a href={wa} target="_blank" rel="noopener" class="neu-sm neu-press inline-flex h-14 items-center gap-2.5 rounded-full px-7 text-[15px] font-medium text-[#2f8fdc]">
            <Icon name="whatsapp" size={18} /> WhatsApp
          </a>
        </div>
      </div>
    </section>

    <!-- NETZWERK: Mobile = je ein Screen für Headliner und für jeden 4er-Block, Desktop = ein Raster -->
    <section class="mx-auto max-w-[1440px] px-4 md:px-10 md:pt-[var(--section)]">
      <div class="screen md:contents">
        <div id="netzwerk" class="mb-8 flex flex-col gap-3 md:mb-12 md:flex-row md:items-end md:justify-between md:gap-4">
          <h2 class="display text-[clamp(2.75rem,13vw,3.5rem)] md:text-[min(7.2vw,8rem)]" data-reveal>Netzwerk.</h2>
          <p class="meta text-muted md:pb-3" data-reveal style="--d:120ms">Unser Netzwerk arbeitet für</p>
        </div>
        <div class="grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6">
          {headliners.map((c, i) => <LogoTile client={c} i={i} />)}
        </div>
      </div>
      {chunks.map((chunk, k) => (
        <div class="screen md:contents">
          <p class="meta mb-4 text-muted md:hidden">Außerdem · {pad(k + 1)} / {pad(chunks.length)}</p>
          <div class="grid grid-cols-2 gap-4 md:mt-6 md:grid-cols-4 md:gap-6">
            {chunk.map((c, i) => <LogoTile client={c} i={i} />)}
          </div>
          {k === chunks.length - 1 && <p class="meta mt-4 text-muted" data-reveal>Antippen für Details: was gemacht wurde und von wem aus dem Netzwerk.</p>}
        </div>
      ))}
    </section>

    <!-- ARBEITEN: kuratiert, gedämpft. Mobile = Social-Feed, ein Screen pro Arbeit -->
    <section id="arbeiten" class="mx-auto max-w-[1440px] px-4 md:scroll-mt-16 md:px-10 md:pt-[var(--section)]">
      <div class="screen md:contents">
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between md:gap-6">
          <h2 class="display text-[clamp(3.25rem,16vw,4.25rem)] md:text-[min(7.2vw,8rem)]" data-reveal>Arbeiten.</h2>
          <p class="meta max-w-[18rem] text-muted md:pb-3 md:text-right" data-reveal style="--d:120ms">
            Eine Auswahl aus {works.length} Arbeiten des Netzwerks.
          </p>
          <p class="meta flex items-center gap-2 text-muted md:hidden" data-reveal style="--d:240ms">
            <Icon name="arrow-down" size={14} class="swipe" /> Wischen für die nächste Arbeit
          </p>
        </div>
      </div>
      <div class="md:mt-12 md:grid md:grid-cols-3 md:gap-x-4 md:gap-y-2">
        {featured.map((w, i) => <WorkTile work={w} i={i} crop feed total={featured.length} sizes="(min-width: 768px) 30vw, 92vw" />)}
      </div>
      <div class="screen md:block md:h-auto md:p-0">
        <p class="meta mb-4 text-muted md:hidden">Noch {works.length - featured.length} weitere</p>
        <a href={`${base}/arbeiten/`} class="neu neu-press group mt-0 flex items-center justify-between rounded-full px-6 py-5 md:mt-6 md:px-8 md:py-6" data-reveal>
          <span class="text-[17px] font-medium tracking-[-0.02em] md:text-[19px]">Alle {works.length} Arbeiten ansehen</span>
          <Icon name="arrow" size={20} class="transition-transform duration-700 ease-[var(--ease-out)] group-hover:translate-x-1.5" />
        </a>
      </div>
    </section>

    <!-- DISZIPLINEN -->
    <section id="disziplinen" class="screen mx-auto max-w-[1440px] px-4 md:block md:h-auto md:px-10 md:pb-0 md:pt-[var(--section)]">
      <p class="meta mb-4 text-muted md:mb-8" data-reveal>Disziplinen im Netzwerk</p>
      <ul>
        {disciplines.map((d, i) => {
          const who = [...whoBy(d.label), ...(whoExtra[d.label] ?? [])];
          return (
            <li class="border-t border-line last:border-b" data-reveal style={`--d:${i * 90}ms`}>
              <a href={`${base}/arbeiten/#${d.id}`} class="disc group flex items-end justify-between gap-2 py-3 md:flex-row md:items-end md:justify-between md:py-6">
                <span class="display text-[clamp(2.1rem,10vw,2.6rem)] transition-transform duration-700 ease-[var(--ease-out)] group-hover:translate-x-2 md:text-[min(7.2vw,8rem)]">{d.label}</span>
                <span class="meta flex gap-6 pb-1 text-muted md:pb-3 md:text-right">
                  <span class="hidden md:inline md:max-w-[16rem]">{who.join(', ')}</span>
                  <span class="tabular-nums">{pad(counts[d.id] ?? 0)}</span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>

    <!-- ABSCHLUSS -->
    <section class="screen mx-auto max-w-[1440px] px-4 md:block md:h-auto md:px-10 md:pb-10 md:pt-[var(--section)]">
      <h2 class="display text-[clamp(3.25rem,16vw,4.5rem)] md:text-[min(12vw,13rem)]" data-reveal>Ein Anruf.</h2>
      <div class="mt-6 flex flex-col gap-6 md:mt-10 md:flex-row md:items-end md:justify-between" data-reveal style="--d:120ms">
        <a href={tel} class="meta text-muted transition-colors hover:text-fg">{site.phoneDisplay} · Mo–Fr erreichbar</a>
        <div class="hidden items-center gap-2 md:flex">
          <a href={tel} class="btn-call inline-flex h-12 items-center gap-2.5 rounded-full px-6 text-[15px] font-semibold">
            <Icon name="phone" size={17} /> Marvin anrufen
          </a>
          <a href={wa} target="_blank" rel="noopener" class="neu-sm neu-press inline-flex h-12 items-center gap-2.5 rounded-full px-6 text-[15px] font-medium text-[#2f8fdc]">
            <Icon name="whatsapp" size={18} /> WhatsApp
          </a>
        </div>
      </div>
      <footer class="meta mt-16 flex flex-wrap justify-between gap-4 border-t border-line pt-5 text-muted md:mt-32">
        <span>© 2026 {site.name}</span>
        <span class="flex gap-6"><a href={`${base}/b/`} class="hover:text-fg">Entwurf B →</a><a href={`${base}/c/`} class="hover:text-fg">Entwurf C →</a><a href={`${base}/d/`} class="hover:text-fg">D →</a><a href={`${base}/e/`} class="hover:text-fg">E →</a><a href="#" class="hover:text-fg">Impressum</a><a href="#" class="hover:text-fg">Datenschutz</a></span>
      </footer>
    </section>
  </main>

  <StickyCall />
  <ClientDialog clients={clients} works={works} />
</Base>

<style>
  @media (max-width: 767px) {
    .screen-hero { height: 100svh; min-height: 0; }
    .head { background: var(--bg); }
    .swipe { animation: swipe 2.4s var(--ease-soft) infinite; }
  }
  @keyframes swipe {
    0%, 100% { transform: translateY(0); opacity: 0.5; }
    50% { transform: translateY(4px); opacity: 1; }
  }
  .head { transition: background-color 0.6s var(--ease-out), box-shadow 0.6s var(--ease-out); }
  :global(html[data-after-hero]) .head { background: var(--bg); box-shadow: 0 10px 30px -18px rgb(22 27 29 / 0.25); }
</style>
