---
/**
 * Detailansicht pro Marke/Creator: Glas-Sheet auf Mobile, Glas-Overlay auf Desktop.
 * Inhalte liegen als <template> vor und werden beim Öffnen eingesetzt.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import CallButton from './CallButton.astro';
import { wa } from '../site.config';
import { pick, withBase, type Work } from '../lib/works';

interface Props { clients: CollectionEntry<'clients'>[]; works: Work[] }
const { clients, works } = Astro.props;
---

{clients.map((client) => {
  const c = client.data;
  const ws = c.works.map((k) => pick(works, k));
  return (
    <template id={`client-${client.id}`}>
      <div data-dlg class="flex items-center gap-4">
        {c.logo ? (
          <img src={withBase(c.logo)} alt={c.name} class="w-auto max-w-[220px] object-contain" style={`height: calc(var(--dl) * ${(c.scale / Math.sqrt(c.aspect)).toFixed(3)})`} />
        ) : c.photo ? (
          <Image src={c.photo} alt={c.name} width={160} height={160} class="size-14 rounded-full object-cover md:size-16" />
        ) : null}
      </div>
      <h2 data-dlg class="mt-10 text-[clamp(2rem,8.4vw,2.5rem)] font-semibold leading-[0.95] tracking-[-0.05em] [text-wrap:balance] md:text-[3.25rem]">
        Unser Netzwerk arbeitet für <span class="whitespace-nowrap text-soft">{c.name}.</span>
      </h2>
      <dl class="mt-9 flex flex-col gap-1.5">
        {c.items.map((it) => (
          <div data-dlg class="cd-row grid grid-cols-[1fr_auto] items-baseline gap-x-6 gap-y-1 rounded-[20px] px-5 py-4 md:grid-cols-[1.4fr_1fr_auto]">
            <dt class="text-[16px] font-semibold tracking-[-0.01em]">{it.what}</dt>
            <dd class="col-start-1 text-[12px] leading-[1.35] text-muted md:col-start-auto">Aus dem Netzwerk: <span class="text-fg">{it.who}</span></dd>
            <dd class="col-start-2 row-start-1 text-[12px] leading-[1.35] text-muted md:col-start-auto md:row-auto">{it.discipline}</dd>
          </div>
        ))}
      </dl>
      {ws.length > 0 && (
        <div data-dlg class="no-scrollbar mt-7 flex gap-4 overflow-x-auto px-1 pt-3 pb-5">
          {ws.map((w) => (
            <Image src={w.data.image} alt={`${w.data.kind}: ${w.data.title}`} widths={[480, 800]} sizes="320px" class="cd-work h-44 w-auto shrink-0 rounded-[22px] object-cover" />
          ))}
        </div>
      )}
      <div data-dlg class="mt-7 flex gap-2">
        <CallButton size="dialog" label="Marvin dazu anrufen" class="flex-1 md:flex-none" />
        <a href={wa} target="_blank" rel="noopener" class="btn flex h-[60px] items-center justify-center gap-2.5 px-6 text-[17px] font-semibold tracking-[-0.02em]" aria-label="WhatsApp schreiben">
          <Icon name="whatsapp" size={21} /><span class="hidden md:inline">WhatsApp</span>
        </a>
      </div>
    </template>
  );
})}

<dialog id="client-dialog" class="cd" aria-label="Details">
  <div class="cd-panel">
    <button type="button" class="btn cd-close grid size-11 place-items-center" data-close aria-label="Schließen">
      <Icon name="close" size={12} />
    </button>
    <div class="cd-body"></div>
  </div>
</dialog>

<style is:global>
  .cd {
    --dl: 64px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--fg);
    max-width: 100vw;
    max-height: 100svh;
    width: calc(100% - 16px);
    margin: auto auto 8px;
    overflow: visible;
  }
  .cd::backdrop {
    background: rgb(0 0 0 / 0.2);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
    opacity: 0;
    transition: opacity 0.5s var(--ease-out);
  }
  .cd.is-open::backdrop { opacity: 1; }
  .cd-panel {
    position: relative;
    max-height: 88svh;
    overflow-y: auto;
    overscroll-behavior: contain;
    border-radius: 36px;
    padding: 28px 20px max(24px, env(safe-area-inset-bottom));
    background: linear-gradient(160deg, rgb(255 255 255 / 0.88), rgb(255 255 255 / 0.62));
    -webkit-backdrop-filter: blur(40px) saturate(200%);
    backdrop-filter: blur(40px) saturate(200%);
    box-shadow: inset 0 1px 0.5px #fff, 0 0 0 0.5px rgb(255 255 255 / 0.9), 0 40px 80px -30px rgb(0 0 0 / 0.25);
    transform: translate3d(0, 100%, 0);
    transition: transform 0.75s cubic-bezier(0.34, 1.15, 0.5, 1);
  }
  .cd.is-open .cd-panel { transform: none; }
  .cd-close { position: absolute; right: 20px; top: 20px; z-index: 5; }
  .cd-row { background: rgb(255 255 255 / 0.6); box-shadow: inset 0 1px 0.5px #fff, 0 0 0 0.5px rgb(0 0 0 / 0.1); }
  .cd-work {
    border: 5px solid rgb(255 255 255 / 0.8);
    box-shadow: 0 14px 30px -18px rgb(0 0 0 / 0.4);
    transition: translate 0.6s var(--ease-spring), box-shadow 0.6s;
  }
  .cd-work:hover { translate: 0 -6px; box-shadow: 0 24px 40px -18px rgb(0 0 0 / 0.22); }
  @media (min-width: 768px) {
    .cd { --dl: 84px; width: min(880px, calc(100vw - 80px)); margin: auto; }
    .cd-panel {
      border-radius: 40px;
      padding: 52px 52px 48px;
      max-height: calc(100svh - 80px);
      transform: translate3d(0, 30px, 0) scale(0.94);
      opacity: 0;
      transition: transform 0.75s cubic-bezier(0.34, 1.15, 0.5, 1), opacity 0.5s var(--ease-out);
    }
    .cd.is-open .cd-panel { transform: none; opacity: 1; }
  }
</style>
