---
import '../styles/global.css';
import { site } from '../site.config';

interface Props { title?: string; htmlClass?: string }
const { title = `${site.name} – Ein Name. Ein Anruf.`, htmlClass } = Astro.props;
---

<!doctype html>
<html lang="de" class={htmlClass}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FFFFFF" />
    <meta name="description" content={site.claim} />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="min-h-svh bg-bg text-fg">
    <slot />
    <script>
      import '../lib/client.ts';
    </script>
  </body>
</html>
