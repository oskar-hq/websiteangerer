---
/** Ein Mac-Fenster mit Arbeit drin und Dateiname darunter (heyclicky). Optional ziehbar. */
import WorkMedia from '../WorkMedia.astro';
import type { Work } from '../../lib/works';
interface Props { work: Work; file?: string; class?: string; style?: string; width?: string; ambient?: boolean; drag?: boolean }
const { work, file, class: cls = '', style = '', width = '220px', ambient = true, drag = true } = Astro.props;
const name = file ?? `${work.id.replace(/^\d+-/, '')}.${work.data.medium === 'video' ? 'mov' : 'jpg'}`;
---
<figure class:list={['win-wrap', cls]} style={`--ww:${width}; ${style}`} data-drag={drag ? '' : undefined}>
  <div class="win">
    <div class="win-bar">
      <span class="dot" style="background:#ff5f57"></span><span class="dot" style="background:#febc2e"></span><span class="dot" style="background:#28c840"></span>
      <span class="ml-auto text-[10px] text-[#9a9a9a]">✕</span>
    </div>
    <div class="win-body">
      <WorkMedia work={work} sizes="320px" ambient={ambient && work.data.medium === 'video'} class="h-full w-full object-cover" />
    </div>
  </div>
  <figcaption class="mono mt-2 whitespace-nowrap text-center text-[11px] text-[var(--muted)]">{name}</figcaption>
</figure>
<style>
  .win-wrap { width: var(--ww); user-select: none; }
  .win {
    background: #f6f6f6;
    border: 1px solid #d4d0cb;
    border-radius: 9px;
    overflow: hidden;
    box-shadow: 0 1px 0 #fff inset, 0 18px 40px -18px rgb(28 25 23 / 0.35), 0 2px 6px rgb(28 25 23 / 0.08);
    transition: box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .win-bar {
    display: flex; align-items: center; gap: 5px;
    height: 22px; padding: 0 8px;
    background: linear-gradient(#fbfbfb, #ececec);
    border-bottom: 1px solid #dedad5;
  }
  .dot { width: 9px; height: 9px; border-radius: 99px; box-shadow: inset 0 0 0 0.5px rgb(0 0 0 / 0.2); }
  .win-body { aspect-ratio: var(--wa, 4 / 3); background: #222; }
  [data-drag] { cursor: grab; touch-action: none; }
  [data-drag].is-dragging { cursor: grabbing; z-index: 50 !important; }
  [data-drag].is-dragging .win { box-shadow: 0 1px 0 #fff inset, 0 34px 70px -20px rgb(28 25 23 / 0.45); }
</style>
