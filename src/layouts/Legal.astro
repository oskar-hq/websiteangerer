---
/**
 * Schlichte Textseite für Impressum und Datenschutz – gleicher Grund und Header-Stil wie die Startseite.
 */
import Base from './Base.astro';
import { site } from '../site.config';
import { withBase } from '../lib/works';

interface Props { title: string }
const { title } = Astro.props;
---

<Base title={`${title} – ${site.name}`}>
  <header class="mx-auto flex h-[60px] max-w-[880px] items-center justify-between px-5 pt-4 md:px-7">
    <a href={withBase('/')} class="text-[16px] font-semibold tracking-[-0.03em]">{site.name}</a>
    <a href={withBase('/')} class="btn flex h-10 items-center rounded-full px-4 text-[13px] font-medium">← Zur Startseite</a>
  </header>

  <main class="legal mx-auto max-w-[880px] px-5 pt-16 pb-20 md:px-7 md:pt-24">
    <h1 class="text-[clamp(2.4rem,11vw,3rem)] leading-[0.98] font-semibold tracking-[-0.05em] md:text-[4rem]">{title}</h1>
    <div class="mt-10 md:mt-14">
      <slot />
    </div>
  </main>

  <footer class="mx-auto max-w-[880px] px-5 pb-10 md:px-7">
    <div class="glass-chip flex flex-wrap items-center justify-between gap-4 rounded-full px-[22px] py-3.5 text-[12px]">
      <span>©2026 {site.name}</span>
      <span class="flex flex-wrap gap-5">
        <a href={withBase('impressum/')} class="transition-colors hover:text-muted">Impressum</a>
        <a href={withBase('datenschutz/')} class="transition-colors hover:text-muted">Datenschutz</a>
      </span>
    </div>
  </footer>
</Base>

<style>
  .legal :global(h2) { margin-top: 2.75rem; font-size: 20px; font-weight: 600; letter-spacing: -0.025em; }
  .legal :global(h3) { margin-top: 1.75rem; font-size: 16px; font-weight: 600; letter-spacing: -0.015em; }
  .legal :global(p), .legal :global(ul) { margin-top: 0.75rem; max-width: 68ch; font-size: 15px; line-height: 1.6; color: var(--muted); }
  .legal :global(ul) { padding-left: 1.2em; list-style: disc; }
  .legal :global(li + li) { margin-top: 0.25rem; }
  .legal :global(strong) { color: var(--fg); font-weight: 600; }
  .legal :global(a) { color: var(--fg); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; overflow-wrap: anywhere; }
  .legal :global(h2:first-child) { margin-top: 0; }
</style>
