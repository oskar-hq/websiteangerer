---
/**
 * PLATZHALTER-Logo. Simuliert eine Logo-Wolke unterschiedlicher Marken,
 * bis echte SVG-Logos vorliegen (dann hier durch <img> ersetzen).
 */
interface Props { name: string; i: number; class?: string }
const { name, i, class: cls = '' } = Astro.props;
const style = i % 6;
---
<span class:list={['logo-mark inline-flex items-center whitespace-nowrap select-none', `lm-${style}`, cls]} title="Platzhalter-Logo">
  {style === 4 && <span class="mr-1.5 inline-block size-[0.8em] rounded-full border-[0.14em] border-current" />}
  {name}
</span>

<style>
  .logo-mark { line-height: 1; }
  .lm-0 { font-family: 'Geist Variable', sans-serif; font-weight: 800; text-transform: uppercase; letter-spacing: -0.04em; }
  .lm-1 { font-family: 'Instrument Serif', serif; font-style: italic; font-size: 1.18em; letter-spacing: -0.01em; }
  .lm-2 { font-family: 'Geist Mono Variable', monospace; font-weight: 500; text-transform: uppercase; letter-spacing: 0.14em; font-size: 0.78em; }
  .lm-3 { font-family: 'Bricolage Grotesque Variable', sans-serif; font-weight: 800; letter-spacing: -0.05em; font-size: 1.08em; }
  .lm-4 { font-family: 'Inter Variable', sans-serif; font-weight: 600; letter-spacing: -0.02em; }
  .lm-5 { font-family: 'Instrument Sans Variable', sans-serif; font-weight: 400; text-transform: uppercase; letter-spacing: 0.22em; font-size: 0.8em; }
</style>
