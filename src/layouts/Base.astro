---
import '../styles/global.css';
import { site, seo, legal, disciplines } from '../site.config';
import { withBase } from '../lib/works';

interface Props { title?: string; description?: string; htmlClass?: string }
const { title = seo.title, description = seo.description, htmlClass } = Astro.props;
// Absolute Adressen für Teilen-Vorschauen (WhatsApp, LinkedIn, X …) – Bild und Icons erzeugt src/lib/share.ts
const url = new URL(Astro.url.pathname, Astro.site);
const abs = (p: string) => new URL(withBase(p), Astro.site).href;
// Strukturierte Daten für Google: wer hinter der Seite steht
const home = abs('/');
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${home}#website`, url: home, name: site.name, inLanguage: 'de-DE', publisher: { '@id': `${home}#person` } },
    {
      '@type': 'Person', '@id': `${home}#person`, name: site.name, url: home, image: abs('og.jpg'),
      description: seo.description,
      email: legal.email,
      areaServed: { '@type': 'Country', name: 'Deutschland' },
      address: { '@type': 'PostalAddress', streetAddress: legal.street, postalCode: legal.city.split(' ')[0], addressLocality: legal.city.split(' ').slice(1).join(' '), addressCountry: 'DE' },
      knowsAbout: disciplines.map((d) => d.label),
    },
  ],
};
---

<!doctype html>
<html lang="de" class={htmlClass}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f2f2f3" />
    <meta name="description" content={description} />
    <link rel="canonical" href={url.href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:url" content={url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={abs('og.jpg')} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} – Kontaktkarte, umkreist von Marken und Creatorn aus dem Netzwerk`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={abs('og.jpg')} />
    <title>{title}</title>
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('icons/180.png')} />
    <link rel="manifest" href={withBase('site.webmanifest')} />
    <link rel="sitemap" href={withBase('sitemap.xml')} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="min-h-svh bg-bg text-fg">
    <slot />
    <script>
      import '../lib/client.ts';
    </script>
  </body>
</html>
