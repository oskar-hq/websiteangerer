---
import type { HTMLAttributes } from 'astro/types';
interface Props extends HTMLAttributes<'svg'> { name: 'phone' | 'phone-fill' | 'whatsapp' | 'arrow' | 'arrow-down' | 'close' | 'play'; size?: number }
const { name, size = 18, class: cls, ...rest } = Astro.props;
---
{name === 'phone' && (
  <svg class={cls} {...rest} width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6.6 3.5h-2A1.6 1.6 0 0 0 3 5.2C3.4 13.3 10.7 20.6 18.8 21a1.6 1.6 0 0 0 1.7-1.6v-2a1 1 0 0 0-.8-1l-3.4-.8a1 1 0 0 0-1 .3l-1.4 1.5a13 13 0 0 1-6.3-6.3l1.5-1.4a1 1 0 0 0 .3-1l-.8-3.4a1 1 0 0 0-1-.8Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
)}
{name === 'phone-fill' && (
  <svg class={cls} {...rest} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true"><path d="M19.23 15.26l-2.54-.29a1.99 1.99 0 0 0-1.64.57l-1.84 1.84a15.05 15.05 0 0 1-6.59-6.59l1.85-1.85c.43-.43.64-1.03.57-1.64l-.29-2.52a2 2 0 0 0-1.99-1.77H5.03c-1.13 0-2.07.94-2 2.07.53 8.54 7.36 15.36 15.89 15.89 1.13.07 2.07-.87 2.07-2v-1.73c.01-1.01-.75-1.86-1.76-1.98Z" fill="currentColor"/></svg>
)}
{name === 'whatsapp' && (
  <svg class={cls} {...rest} width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3.5 20.5l1.2-4.3A8.5 8.5 0 1 1 8 19.4l-4.5 1.1Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M9 8.6c.2-.5.5-.6.8-.6h.5c.2 0 .4 0 .5.4l.7 1.6c.1.2 0 .4-.1.6l-.5.6c-.1.1-.2.3 0 .5.4.7 1.4 1.8 2.6 2.3.2.1.4.1.5 0l.7-.8c.2-.2.4-.2.6-.1l1.5.7c.2.1.4.2.4.4 0 .5-.1 1.2-.7 1.6-.6.4-1.6.6-3.2-.1-1.9-.8-3.6-2.6-4.2-3.9-.6-1.2-.4-2.4.1-3.2Z" fill="currentColor"/></svg>
)}
{name === 'arrow' && (
  <svg class={cls} {...rest} width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
)}
{name === 'arrow-down' && (
  <svg class={cls} {...rest} width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14m-5-5 5 5 5-5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
)}
{name === 'close' && (
  <svg class={cls} {...rest} width={size} height={size} viewBox="0 0 12 12" aria-hidden="true"><path d="M1.5 1.5l9 9M10.5 1.5l-9 9" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
)}
{name === 'play' && (
  <svg class={cls} {...rest} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.6v12.8a1 1 0 0 0 1.5.86l10.2-6.4a1 1 0 0 0 0-1.72L9.5 4.74A1 1 0 0 0 8 5.6Z" fill="currentColor"/></svg>
)}
