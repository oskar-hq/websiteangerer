---
/** Mobile: schwebende Glas-Leiste im Daumenbereich, erscheint nach dem Hero. */
import CallButton from './CallButton.astro';
---

<div class="sticky-call md:hidden" data-sticky>
  <div class="flex gap-2">
    <CallButton size="bar" />
  </div>
</div>

<style>
  .sticky-call {
    position: fixed;
    left: 12px;
    right: 12px;
    bottom: max(12px, env(safe-area-inset-bottom));
    z-index: 1000;
    padding: 8px;
    border-radius: 999px;
    background: linear-gradient(160deg, rgb(255 255 255 / 0.75), rgb(255 255 255 / 0.4));
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    backdrop-filter: blur(24px) saturate(180%);
    box-shadow: inset 0 1px 0.5px #fff, 0 0 0 0.5px rgb(255 255 255 / 0.9), 0 18px 40px -14px rgb(0 0 0 / 0.4);
    transform: translate3d(0, 140%, 0);
    transition: transform 0.7s cubic-bezier(0.34, 1.2, 0.5, 1);
  }
  :global(html.is-past) .sticky-call { transform: none; }
</style>
