---
/**
 * Rückruf-Button im Stil der iOS-Kontaktkarte: weiße Pille, blauer Hörer im hellgrauen Kreis.
 * Öffnet das Rückruf-Formular; context nennt den Anlass (Marke, Arbeit). size steuert die Maße.
 */
import Icon from './Icon.astro';

interface Props {
  size: 'header' | 'hero' | 'end' | 'bar' | 'dialog';
  label?: string;
  context?: string;
  class?: string;
}
const { size, label = 'Rückruf anfordern', context = '', class: cls } = Astro.props;
const magnet = size === 'hero' || size === 'end' ? '0.2' : size === 'header' ? '0.25' : undefined;
const big = size === 'hero' || size === 'end';
---

<button
  type="button"
  data-callback={context}
  class:list={['btn call', cls]}
  data-size={size}
  data-magnet={magnet}
  data-cursor={big ? 'Rückruf anfordern' : undefined}
  aria-label={label === 'Rückruf' ? 'Rückruf anfordern' : undefined}
>
  <span class="call-in" data-magnet-inner>
    <span class="call-ico" aria-hidden="true"><Icon name="phone-fill" size={24} /></span>
    {label}
  </span>
</button>

<style>
  .call {
    --h: 44px; --fs: 15px; --ico: 34px; --glyph: 17px; --pr: 18px; --gap: 9px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: var(--h);
    padding: 0 var(--pr) 0 calc((var(--h) - var(--ico)) / 2);
    font-size: var(--fs);
    font-weight: 600;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .call-in { display: flex; align-items: center; gap: var(--gap); }
  .call-ico {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: var(--ico);
    height: var(--ico);
    border-radius: 999px;
    background: #f2f2f4;
    color: var(--blue);
    transition: background 0.3s, color 0.3s;
  }
  .call-ico :global(svg) { width: var(--glyph); height: var(--glyph); }
  @media (hover: hover) {
    .call:hover .call-ico { background: var(--blue); color: #fff; }
  }

  .call[data-size='hero'] { --h: 60px; --fs: 18px; --ico: 48px; --glyph: 22px; --pr: 26px; --gap: 12px; }
  .call[data-size='end'] { --h: 68px; --fs: 20px; --ico: 54px; --glyph: 24px; --pr: 30px; --gap: 14px; }
  .call[data-size='bar'] { --h: 52px; --fs: 17px; --ico: 40px; --glyph: 19px; --pr: 22px; --gap: 10px; flex: 1; }
  .call[data-size='dialog'] { --h: 60px; --fs: 17px; --ico: 48px; --glyph: 21px; --pr: 28px; --gap: 12px; }
  @media (min-width: 768px) {
    .call[data-size='hero'] { --h: 72px; --fs: 22px; --ico: 58px; --glyph: 26px; --pr: 32px; --gap: 14px; }
    .call[data-size='end'] { --h: 92px; --fs: 30px; --ico: 76px; --glyph: 34px; --pr: 42px; --gap: 18px; }
  }
</style>
