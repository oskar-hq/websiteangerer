---
interface Props { name: 'phone' | 'whatsapp' | 'arrow' | 'arrow-down'; size?: number; class?: string }
const { name, size = 18, class: cls } = Astro.props;
---
{name === 'phone' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6.6 3.5h-2A1.6 1.6 0 0 0 3 5.2C3.4 13.3 10.7 20.6 18.8 21a1.6 1.6 0 0 0 1.7-1.6v-2a1 1 0 0 0-.8-1l-3.4-.8a1 1 0 0 0-1 .3l-1.4 1.5a13 13 0 0 1-6.3-6.3l1.5-1.4a1 1 0 0 0 .3-1l-.8-3.4a1 1 0 0 0-1-.8Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
)}
{name === 'whatsapp' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3.5 20.5l1.2-4.3A8.5 8.5 0 1 1 8 19.4l-4.5 1.1Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M9 8.6c.2-.5.5-.6.8-.6h.5c.2 0 .4 0 .5.4l.7 1.6c.1.2 0 .4-.1.6l-.5.6c-.1.1-.2.3 0 .5.4.7 1.4 1.8 2.6 2.3.2.1.4.1.5 0l.7-.8c.2-.2.4-.2.6-.1l1.5.7c.2.1.4.2.4.4 0 .5-.1 1.2-.7 1.6-.6.4-1.6.6-3.2-.1-1.9-.8-3.6-2.6-4.2-3.9-.6-1.2-.4-2.4.1-3.2Z" fill="currentColor"/></svg>
)}
{name === 'arrow' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
)}
{name === 'arrow-down' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14m-5-5 5 5 5-5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
)}
