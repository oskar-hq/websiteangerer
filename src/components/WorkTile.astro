---
/**
 * Eine Arbeit. Erst in Graustufen, damit die Logos das Lauteste bleiben;
 * Farbe kommt bei Hover (Desktop) bzw. sobald die Kachel im Bild ist (Mobile).
 * feed: Auf Mobile ein ganzer Screen pro Arbeit (Social-Feed), auf Desktop normale Kachel.
 */
import WorkMedia from './WorkMedia.astro';
import { disciplineLabel, type Work } from '../lib/works';
interface Props { work: Work; i: number; crop?: boolean; feed?: boolean; total?: number; sizes?: string }
const { work: w, i, crop = false, feed = false, total, sizes = '(min-width: 1024px) 30vw, (min-width: 768px) 46vw, 100vw' } = Astro.props;
// Dateiname als ruhige Bildunterschrift (wie ein Fenster auf dem Schreibtisch)
const file = `${w.id.replace(/^\d+-/, '')}.${w.data.medium === 'video' ? 'mp4' : 'jpg'}`;
const pad = (n: number) => String(n).padStart(2, '0');
---
<figure
  data-tile
  data-discipline={w.data.discipline}
  data-colorize
  class:list={['work group break-inside-avoid', feed ? 'feed-slide' : 'mb-8 snap-start scroll-mt-16 md:mb-6 md:scroll-mt-0']}
  style={`view-transition-name: w${i}`}
>
  <div class="card neu rounded-[26px] p-2">
    <div class:list={['relative overflow-hidden rounded-[19px] bg-[var(--surface-2)]', crop && 'md:aspect-[4/3]']}>
      <WorkMedia work={w} sizes={sizes} class:list={['media h-auto w-full object-cover', feed ? 'feed-media' : 'max-h-[78svh]', crop ? 'md:absolute md:inset-0 md:h-full md:max-h-none' : 'md:max-h-none']} />
    </div>
    <figcaption class="meta flex justify-between gap-4 px-2.5 pb-1.5 pt-3">
      <span class="min-w-0 truncate"><span class="text-fg">{file}</span> <span class="text-muted">· {w.data.client}</span></span>
      <span class="shrink-0 text-muted">{disciplineLabel(w.data.discipline)}</span>
    </figcaption>
  </div>
  {feed && (
    <p class="feed-meta meta text-muted md:hidden">
      <span class="text-fg">{w.data.title}</span><br />{w.data.kind}{total ? <span> · <span data-pos>{pad(i + 1)}</span> / <span data-total>{pad(total)}</span></span> : null}
    </p>
  )}
</figure>
<style>
  .work :global(.media) {
    filter: grayscale(1) contrast(0.92) brightness(1.04);
    transition: filter 1.2s var(--ease-out), transform 1.4s var(--ease-out);
  }
  .card { transition: box-shadow 0.7s var(--ease-out); }
  @media (hover: hover) { .work:hover .card { box-shadow: var(--neu-lg); } }
  .work.is-color :global(.media) { filter: none; }
  @media (hover: hover) and (pointer: fine) {
    .work.is-color :global(.media) { filter: grayscale(1) contrast(0.92) brightness(1.04); }
    .work:hover :global(.media) { filter: none; transform: scale(1.02); }
  }

  /* Social-Feed auf Mobile: ein Screen pro Arbeit, Kopfleiste oben, Anruf-Leiste unten */
  @media (max-width: 767px) {
    .feed-slide {
      height: 100svh;
      margin: 0;
      padding: 72px 0 104px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 14px;
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }
    .feed-slide :global(.feed-media) {
      max-height: calc(100svh - 72px - 104px - 120px);
      object-fit: contain;
      background: var(--surface-2);
    }
    .feed-meta { padding: 0 10px; line-height: 1.5; }
  }
  @media (min-width: 768px) {
    .feed-slide { margin-bottom: 1.5rem; }
  }
</style>
