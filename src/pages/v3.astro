---
/**
 * V3 „Index“ – redaktionell: Haarlinien, Nummerierung, Serif-Italic als Akzent.
 */
import Base from '../layouts/Base.astro';
import WorkMedia from '../components/WorkMedia.astro';
import StickyCall from '../components/StickyCall.astro';
import LogoMark from '../components/LogoMark.astro';
import Icon from '../components/Icon.astro';
import { site, tel, wa, disciplines } from '../site.config';
import { getWorks, disciplineLabel, countBy } from '../lib/works';

const works = await getWorks();
const counts = countBy(works);
const pad = (n: number) => String(n).padStart(2, '0');
const total = pad(works.length);
---

<Base theme="v3" current="v3" title={`${site.name} – V3 Index`}>
  <header class="v3-head absolute inset-x-0 top-0 z-40 md:fixed">
    <div class="mx-auto grid h-14 max-w-[1440px] grid-cols-2 items-center px-4 text-[14px] md:h-16 md:grid-cols-12 md:gap-6 md:px-10">
      <a href="#top" class="font-semibold tracking-[-0.02em] md:col-span-3">{site.name}</a>
      <span class="hidden text-muted md:col-span-6 md:block">Design, Video, Social Media, Management &amp; Software — aus einer Hand.</span>
      <a href={tel} class="v3-link hidden justify-self-end md:col-span-3 md:inline-flex">Anrufen <Icon name="arrow" size={16} /></a>
    </div>
  </header>

  <main id="top" class="pb-24 md:pb-0">
    <!-- 1 · HERO -->
    <section data-hero class="flex min-h-svh flex-col pb-[84px] pt-14 md:pb-0 md:pt-16">
      <div class="mx-auto w-full max-w-[1440px] px-4 md:px-10">
        <dl class="grid grid-cols-2 border-y border-line text-[13px] md:grid-cols-4" data-reveal>
          {[
            ['Netzwerk', `${pad(disciplines.length)} Disziplinen`],
            ['Arbeiten', `${total} kuratiert`],
            ['Region', 'Deutschland'],
            ['Kontakt', 'Telefon & WhatsApp'],
          ].map(([k, v], i) => (
            <div class:list={['py-3 md:py-4', i % 2 === 1 && 'border-l border-line pl-3 md:pl-4', i === 2 && 'md:border-l md:border-line md:pl-4', i >= 2 && 'border-t border-line md:border-t-0']}>
              <dt class="text-muted">{k}</dt>
              <dd class="font-medium">{v}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="mx-auto flex w-full max-w-[1440px] flex-1 flex-col justify-center px-4 py-10 md:px-10 md:py-12">
        <h1 class="display font-semibold text-[clamp(2.7rem,12.4vw,3.6rem)] leading-[0.98] tracking-[-0.045em] md:text-[min(6.6vw,12.5svh)] md:leading-[0.96]">
          <span data-reveal style="--d:60ms" class="inline">Ein Name. Ein Anruf. </span>
          <span data-reveal style="--d:160ms" class="inline"><em class="font-serif font-normal tracking-[-0.02em] text-accent-ink">Das Beste,</em> was Deutschland zu bieten hat.</span>
        </h1>
        <div class="mt-10 hidden items-center gap-3 md:flex" data-reveal style="--d:260ms">
          <a href={tel} class="inline-flex h-14 items-center gap-3 bg-fg pl-6 pr-7 text-[16px] font-medium text-bg transition-colors hover:bg-accent hover:text-on-accent">
            <Icon name="phone" size={18} /> {site.phoneDisplay}
          </a>
          <a href={wa} target="_blank" rel="noopener" class="inline-flex h-14 items-center gap-3 px-6 text-[16px] font-medium shadow-[inset_0_0_0_1px_var(--line)] transition-shadow hover:shadow-[inset_0_0_0_1px_var(--fg)]">
            <Icon name="whatsapp" size={19} /> WhatsApp
          </a>
          <span class="ml-4 text-[13px] text-muted">oder einfach weiterscrollen <Icon name="arrow-down" size={14} class="inline" /></span>
        </div>
      </div>

      <!-- Logos: Desktop als Tabelle, Mobile als Laufband -->
      <div class="mx-auto w-full max-w-[1440px] md:px-10" data-reveal style="--d:360ms">
        <p class="flex justify-between px-4 pb-2 text-[12px] text-muted md:px-0"><span>Kunden &amp; Creator</span><span>Platzhalter-Logos</span></p>
        <div class="overflow-hidden border-t border-line md:hidden">
          <div class="marquee py-5">
            {[0, 1].map((dup) => (
              <ul class="flex shrink-0 items-center gap-10 pr-10 text-[17px] text-fg/55" aria-hidden={dup === 1 ? 'true' : undefined}>
                {site.logos.map((l, i) => <li><LogoMark name={l} i={i} /></li>)}
              </ul>
            ))}
          </div>
        </div>
        <ul class="hidden grid-cols-8 border-t border-line md:grid">
          {site.logos.map((l, i) => (
            <li class:list={['flex h-20 items-center justify-center text-[17px] text-fg/50 transition-colors hover:text-fg', i > 0 && 'border-l border-line']}><LogoMark name={l} i={i} /></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 2 · DIE WAND -->
    <section id="wand" data-wall data-active="all" class="md:scroll-mt-16">
      <div class="mx-auto max-w-[1440px] px-4 pt-20 md:px-10 md:pt-36">
        <div class="grid gap-6 border-t border-fg pt-5 md:grid-cols-12">
          <p class="text-[13px] text-muted md:col-span-3">§ 01 — Die Wand</p>
          <h2 class="display font-semibold text-[clamp(2.4rem,11vw,3.2rem)] tracking-[-0.045em] md:col-span-9 md:text-[clamp(3.5rem,6vw,6rem)]" data-reveal>
            Was das Netzwerk <em class="font-serif font-normal tracking-[-0.02em]">gemacht</em> hat.
          </h2>
        </div>
      </div>

      <div class="sticky top-0 z-30 mt-8 bg-bg/90 backdrop-blur-md md:static md:mt-14 md:bg-transparent md:backdrop-blur-none">
        <div class="mx-auto max-w-[1440px] md:px-10">
          <div class="v3-filter flex items-baseline gap-5 overflow-x-auto px-4 py-3 text-[15px] [scrollbar-width:none] md:gap-7 md:border-b md:border-line md:px-0 md:pb-4 md:pt-0 md:text-[17px]" role="toolbar" aria-label="Nach Disziplin filtern">
            <span class="hidden shrink-0 text-muted md:inline">Zeige</span>
            <button type="button" data-filter="all" aria-pressed="true">Alles</button>
            {disciplines.map((d) => <button type="button" data-filter={d.id} aria-pressed="false">{d.label}</button>)}
            <span class="ml-auto hidden shrink-0 text-[13px] tabular-nums text-muted md:inline"><span data-count>{total}</span> / {total}</span>
          </div>
        </div>
      </div>

      <div class="mx-auto max-w-[1440px] md:px-10 md:pt-10">
        <ol class="md:grid md:grid-cols-2 md:gap-x-6 md:gap-y-12 lg:grid-cols-3 lg:gap-x-8 lg:gap-y-14">
          {works.map((w, i) => (
            <li data-tile data-discipline={w.data.discipline} class="v3-tile group mb-12 snap-start scroll-mt-14 md:mb-0 md:scroll-mt-0" style={`view-transition-name: w${i}`}>
              <div class="mb-3 flex items-baseline justify-between px-4 text-[13px] md:px-0">
                <span class="v3-num font-medium tabular-nums">{pad(i + 1)}</span>
                <span class="text-muted">{disciplineLabel(w.data.discipline)} / {w.data.kind}</span>
              </div>
              <div class="v3-media relative overflow-hidden bg-surface md:aspect-[4/3]">
                <WorkMedia work={w} sizes="(min-width: 1024px) 30vw, (min-width: 768px) 46vw, 100vw" class="h-auto max-h-[80svh] w-full object-cover object-top md:absolute md:inset-0 md:h-full md:max-h-none" />
                <div class="pointer-events-none absolute left-3 top-3 flex gap-1.5">
                  {w.data.placeholder && <span class="ph-badge">Platzhalter</span>}
                  {w.data.medium === 'video' && <span class="ph-badge">▶ Video</span>}
                </div>
              </div>
              <p class="mt-3 px-4 text-[15px] leading-snug md:px-0">
                <span class="font-medium">{w.data.title}</span> <span class="text-muted">— {w.data.client}</span>
              </p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 3 · DISZIPLINEN -->
    <section id="disziplinen" class="mx-auto max-w-[1440px] px-4 pt-24 md:px-10 md:pt-44">
      <div class="grid gap-6 border-t border-fg pt-5 md:grid-cols-12">
        <p class="text-[13px] text-muted md:col-span-3">§ 02 — Disziplinen</p>
        <h2 class="display font-semibold text-[clamp(2.4rem,11vw,3.2rem)] tracking-[-0.045em] md:col-span-9 md:text-[clamp(3.5rem,6vw,6rem)]" data-reveal>
          Fünf Felder. <em class="font-serif font-normal tracking-[-0.02em]">Ein</em> Kontakt.
        </h2>
      </div>
      <table class="mt-12 w-full border-collapse text-left md:mt-16">
        <thead class="hidden text-[13px] text-muted md:table-header-group">
          <tr class="border-b border-line"><th class="w-[25%] pb-3 font-normal">Nr.</th><th class="pb-3 font-normal">Disziplin</th><th class="pb-3 font-normal">Umfang</th><th class="pb-3 text-right font-normal">Arbeiten</th></tr>
        </thead>
        <tbody>
          {disciplines.map((d, i) => (
            <tr class="v3-row group border-b border-line" data-reveal style={`--d:${i * 60}ms`}>
              <td class="hidden py-6 align-baseline text-[13px] tabular-nums text-muted md:table-cell">{pad(i + 1)}</td>
              <td class="py-5 align-baseline md:py-6">
                <a href="#wand" data-filter={d.id} class="block">
                  <span class="font-serif text-[2.6rem] italic leading-none tracking-[-0.02em] transition-colors group-hover:text-accent-ink md:text-[clamp(2.75rem,4.4vw,4.25rem)]">{d.label}</span>
                  <span class="mt-1.5 block text-[14px] text-muted md:hidden">{d.line}</span>
                </a>
              </td>
              <td class="hidden py-6 align-baseline text-[16px] text-muted md:table-cell">{d.line}</td>
              <td class="py-5 text-right align-baseline text-[13px] tabular-nums text-muted md:py-6">{pad(counts[d.id] ?? 0)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <!-- 4 · ABSCHLUSS -->
    <section class="mx-auto max-w-[1440px] px-4 pb-10 pt-28 md:px-10 md:pb-12 md:pt-52">
      <div class="grid gap-6 border-t border-fg pt-5 md:grid-cols-12">
        <p class="text-[13px] text-muted md:col-span-3">§ 03 — Kontakt</p>
        <div class="md:col-span-9">
          <p class="font-serif text-[2rem] italic leading-none text-muted md:text-[3rem]" data-reveal>Ruf einfach an.</p>
          <a href={tel} class="display mt-4 block font-semibold text-[clamp(2.4rem,11.5vw,3.4rem)] tracking-[-0.05em] transition-colors hover:text-accent-ink md:mt-6 md:text-[clamp(4rem,7.6vw,8rem)]" data-reveal style="--d:80ms">
            {site.phoneDisplay}
          </a>
          <div class="mt-8 flex flex-wrap gap-3 md:mt-12" data-reveal style="--d:160ms">
            <a href={tel} class="inline-flex h-14 items-center gap-3 bg-accent pl-6 pr-7 text-[16px] font-semibold text-on-accent transition-transform hover:-translate-y-0.5"><Icon name="phone" size={18} /> Anrufen</a>
            <a href={wa} target="_blank" rel="noopener" class="inline-flex h-14 items-center gap-3 px-6 text-[16px] font-medium shadow-[inset_0_0_0_1px_var(--line)] transition-shadow hover:shadow-[inset_0_0_0_1px_var(--fg)]"><Icon name="whatsapp" size={19} /> WhatsApp</a>
          </div>
        </div>
      </div>
      <footer class="mt-28 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6 text-[12px] text-muted md:mt-44">
        <span>© 2026 {site.name}</span>
        <span class="flex gap-6"><a href="#" class="hover:text-fg">Impressum</a><a href="#" class="hover:text-fg">Datenschutz</a></span>
      </footer>
    </section>
  </main>

  <StickyCall variant="light" />
</Base>

<style>
  .v3-head { transition: background 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out); }
  :global(html[data-after-hero]) .v3-head {
    @media (min-width: 768px) {
      background: rgb(255 255 255 / 0.86);
      backdrop-filter: blur(14px);
      box-shadow: 0 1px 0 var(--line);
    }
  }
  .v3-link { align-items: center; gap: 6px; color: var(--accent-ink); font-weight: 500; }
  .v3-link :global(svg) { transition: transform 0.3s var(--ease-out); }
  .v3-link:hover :global(svg) { transform: translateX(3px); }

  .v3-filter button {
    flex-shrink: 0;
    color: var(--muted);
    position: relative;
    transition: color 0.25s;
  }
  .v3-filter button:hover { color: var(--fg); }
  .v3-filter button[aria-pressed='true'] {
    color: var(--fg);
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-size: 1.22em;
    line-height: 1;
  }
  .v3-filter button[aria-pressed='true']::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: -3px;
    height: 2px;
    background: var(--accent);
  }

  @media (hover: hover) and (pointer: fine) {
    .v3-media :global(img), .v3-media :global(video) {
      transition: transform 1.1s var(--ease-out), clip-path 0.7s var(--ease-out);
      clip-path: inset(0);
    }
    .v3-tile:hover .v3-media :global(img), .v3-tile:hover .v3-media :global(video) { transform: scale(1.04); }
    .v3-num { transition: color 0.3s; }
    .v3-tile:hover .v3-num { color: var(--accent-ink); }
    .v3-row { transition: background 0.3s; }
    .v3-row:hover { background: var(--surface); }
  }
</style>
