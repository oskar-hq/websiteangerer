---
/** Die volle Wand: alle Arbeiten aus dem Netzwerk, filterbar nach Disziplin. */
import Base from '../../layouts/Base.astro';
import WorkTile from '../../components/WorkTile.astro';
import StickyCall from '../../components/StickyCall.astro';
import Icon from '../../components/Icon.astro';
import { site, tel, disciplines } from '../../site.config';
import { getWorks, countBy } from '../../lib/works';

const works = await getWorks();
const counts = countBy(works);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pad = (n: number) => String(n).padStart(2, '0');
---

<Base title={`Arbeiten – ${site.name}`}>
  <header class="mx-auto flex snap-start h-16 max-w-[1440px] items-center justify-between px-4 md:h-[72px] md:px-10">
    <a href={`${base}/`} class="group flex items-center gap-2 text-[15px] font-semibold tracking-[-0.02em]">
      <Icon name="arrow" size={16} class="rotate-180 transition-transform duration-500 group-hover:-translate-x-1" /> {site.name}
    </a>
    <a href={tel} class="btn-call hidden h-11 items-center gap-2 rounded-full px-5 text-[13px] font-semibold md:inline-flex">
      <Icon name="phone" size={14} /> Anrufen
    </a>
  </header>

  <main class="mx-auto max-w-[1440px] px-4 pb-28 md:px-10 md:pb-24" data-wall data-active="all">
    <div class="flex flex-col gap-6 pt-12 md:flex-row md:items-end md:justify-between md:pt-20">
      <h1 class="display text-[clamp(2.75rem,13vw,3.5rem)] md:text-[min(9vw,10rem)]" data-reveal>Arbeiten.</h1>
      <p class="meta text-muted md:pb-4 md:text-right" data-reveal style="--d:120ms"><span data-count>{pad(works.length)}</span> / {pad(works.length)} Arbeiten aus dem Netzwerk</p>
    </div>

    <div class="sticky top-0 z-20 -mx-4 mt-8 bg-bg px-4 md:mx-0 md:mt-12 md:px-0">
      <div class="filter flex gap-3 overflow-x-auto px-1 py-4 [scrollbar-width:none]" role="toolbar" aria-label="Nach Disziplin filtern">
        <button type="button" data-filter="all" aria-pressed="true">Alle</button>
        {disciplines.map((d) => <button type="button" data-filter={d.id} aria-pressed="false">{d.label} <span class="tabular-nums opacity-60">{counts[d.id] ?? 0}</span></button>)}
      </div>
    </div>

    <div class="mt-4 md:mt-6 md:columns-2 md:gap-4 lg:columns-3">
      {works.map((w, i) => <WorkTile work={w} i={i} />)}
    </div>
  </main>

  <StickyCall />
</Base>

<style>
  .filter button {
    flex-shrink: 0;
    height: 38px;
    padding: 0 16px;
    border-radius: 999px;
    font-size: 13px;
    color: var(--muted);
    background: var(--surface);
    box-shadow: var(--neu-sm);
    transition: box-shadow 0.4s var(--ease-out), color 0.4s var(--ease-out), background-color 0.4s var(--ease-out);
  }
  .filter button:hover { color: var(--fg); }
  .filter button[aria-pressed='true'] { background: var(--accent); color: var(--on-accent); font-weight: 600; box-shadow: inset 4px 4px 9px rgb(20 90 160 / 0.35), inset -4px -4px 9px rgb(160 215 255 / 0.6); }
</style>
