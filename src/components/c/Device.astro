---
/** Tablet in weißer Karte (Hanzo): dunkler Rahmen, Arbeit als Bildschirm. */
import WorkMedia from '../WorkMedia.astro';
import type { Work } from '../../lib/works';
interface Props { work: Work; class?: string; crop?: boolean; sizes?: string }
const { work, class: cls = '', crop = true, sizes = '(min-width: 768px) 46vw, 92vw' } = Astro.props;
---
<div class:list={['dev-card', crop && 'crop', cls]}>
  <div class="tablet">
    <span class="cam" aria-hidden="true"></span>
    <div class="screen-c">
      <WorkMedia work={work} sizes={sizes} class="h-full w-full object-cover" />
    </div>
  </div>
</div>
<style>
  .dev-card {
    position: relative;
    background: linear-gradient(180deg, #ffffff, #f3f3f3);
    border-radius: 26px;
    padding: 9% 8% 0;
    overflow: hidden;
    box-shadow: inset 0 1px 0 #fff, 0 1px 2px rgb(0 0 0 / 0.05);
  }
  .dev-card:not(.crop) { padding-bottom: 8%; }
  .tablet {
    position: relative;
    background: linear-gradient(160deg, #2a2a2a, #0b0b0b 40%, #151515);
    border-radius: 26px;
    padding: 10px;
    box-shadow: 0 0 0 1px #000, inset 0 0 0 1.5px #3a3a3a, 0 30px 50px -24px rgb(0 0 0 / 0.55);
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .crop .tablet { border-bottom-left-radius: 0; border-bottom-right-radius: 0; padding-bottom: 0; }
  .cam { position: absolute; top: 4px; left: 50%; width: 4px; height: 4px; margin-left: -2px; border-radius: 9px; background: #333; }
  .screen-c { aspect-ratio: 4 / 3; border-radius: 17px; overflow: hidden; background: #000; }
  .crop .screen-c { border-bottom-left-radius: 0; border-bottom-right-radius: 0; aspect-ratio: 4 / 2.8; }
  @media (hover: hover) { .dev-card:hover .tablet { transform: translateY(-6px); } }
</style>
