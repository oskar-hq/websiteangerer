---
/** „HALLO, ich bin“-Sticker (heyclicky). */
interface Props { name: string; class?: string; style?: string; color?: string }
const { name, class: cls = '', style = '', color = '#2f6bff' } = Astro.props;
---
<div class:list={['tag', cls]} style={`--tc:${color}; ${style}`} data-drag>
  <div class="tag-top"><span class="mono text-[8px] font-semibold tracking-[0.08em]">HALLO</span><span class="mono text-[6px] tracking-[0.06em] opacity-90">ICH BIN</span></div>
  <div class="tag-name">{name}</div>
  <div class="tag-bottom"></div>
</div>
<style>
  .tag {
    width: 96px; background: #fff; border-radius: 6px; overflow: hidden; user-select: none;
    box-shadow: 0 10px 22px -10px rgb(28 25 23 / 0.4), 0 1px 2px rgb(28 25 23 / 0.15);
  }
  .tag-top { background: var(--tc); color: #fff; display: flex; flex-direction: column; align-items: center; padding: 4px 0 3px; line-height: 1.1; }
  .tag-name { font-family: 'Instrument Serif', serif; font-style: italic; font-size: 22px; text-align: center; padding: 6px 4px 4px; color: #1c1917; }
  .tag-bottom { height: 7px; background: var(--tc); }
  [data-drag] { cursor: grab; touch-action: none; }
</style>
